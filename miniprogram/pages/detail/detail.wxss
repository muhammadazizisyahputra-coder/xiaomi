/* styles for detail page */
.container { padding: 16px }
.note .title { font-weight: bold; font-size:16px; margin-bottom:8px }
.note .content { margin-bottom:12px }
.note .actions button { margin-right:8px }
.note .status { margin-top:8px; color:#888 }
.parsed-section { margin-top:12px; background:#fbfbfb; padding:10px; border-radius:6px }
.label { font-weight:600; color:#333; margin-top:8px }
.value { color:#555; margin-top:6px }
.raw { margin-top:12px; background:#fff7e6; padding:10px; border-radius:4px }
