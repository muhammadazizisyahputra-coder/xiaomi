<view class="container">
  <view class="note">
    <view class="title">{{note.title || ('笔记 #' + note.id)}}</view>
    <view class="content">{{note.content}}</view>

    <view class="actions">
      <button class="float-parse" bindtap="startParse" wx:if="{{!parsing}}">🔮 AI 解析</button>
      <button class="float-cancel" bindtap="cancelPolling" wx:if="{{parsing}}">✖ 取消</button>
    </view>

    <view class="status">状态：{{taskStatus}}</view>

    <block wx:if="{{formattedAvailable}}">
      <view class="cards">
        <view class="info-card">
          <view class="icon">📅</view>
          <view class="label">时间</view>
          <view class="value">{{formatted.time || '--'}}</view>
        </view>

        <view class="info-card">
          <view class="icon">📍</view>
          <view class="label">地点</view>
          <view class="value">{{formatted.location || '--'}}</view>
        </view>

        <view class="info-card">
          <view class="icon">📝</view>
          <view class="label">任务</view>
          <view class="value">{{formatted.task || '--'}}</view>
        </view>

      </view>
    </block>

    <view wx:if="{{!formattedAvailable && formatted.raw}}" class="raw">
      <view class="label">解析原始内容</view>
      <view class="value">{{formatted.raw}}</view>
    </view>

  </view>
</view>
