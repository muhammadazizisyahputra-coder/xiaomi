/* simple login page */
<view class="container">
  <view class="form">
    <input placeholder="用户名" bindinput="onUsername" value="{{username}}" />
    <input placeholder="密码" password="true" bindinput="onPassword" value="{{password}}" />
    <button bindtap="onLogin">登录</button>
    <button bindtap="toRegister">去注册</button>
  </view>
</view>
