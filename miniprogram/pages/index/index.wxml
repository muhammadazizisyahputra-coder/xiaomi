<view class="container">
  <view wx:if="{{notes.length === 0}}" class="empty">
    <view class="empty-icon">📭</view>
    <view class="empty-title">暂无笔记</view>
    <view class="empty-sub">暂无笔记，点击下方按钮添加你的第一条备忘</view>
    <button class="add-btn" bindtap="focusInput">添加笔记</button>
  </view>

  <view wx:else class="list">
    <block wx:for="{{notes}}" wx:key="id">
      <view class="note">
        <view class="title">{{item.title || ('笔记 #' + item.id)}}</view>
        <view class="content">{{item.content}}</view>
        <view class="actions">
          <button bindtap="openDetail" data-id="{{item.id}}">查看</button>
          <button bindtap="deleteNote" data-id="{{item.id}}">删除</button>
        </view>
        <view wx:if="{{item.parsed}}" class="parsed">解析结果：{{item.parsed}}</view>
      </view>
    </block>
  </view>

  <view class="footer">
    <input class="input" placeholder="输入备忘内容" bindinput="onInput" value="{{draft}}" />
    <button class="save-btn" bindtap="createNote">保存</button>
  </view>

  <view class="auth-actions" wx:if="{{!isAuthenticated}}">
    <button bindtap="goLogin">登录</button>
    <button bindtap="goRegister">注册</button>
  </view>
</view>
