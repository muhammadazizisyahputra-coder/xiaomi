<view class="container">
  <!-- Header actions: logout if authenticated -->
  <view class="header-actions">
    <button class="logout-btn" bindtap="logout" wx:if="{{isAuthenticated}}">退出登录</button>
  </view>

  <block wx:if="{{!isAuthenticated}}">
    <!-- Redirecting to login will happen in onLoad if not authenticated -->
  </block>

  <block wx:if="{{notes.length === 0 && isAuthenticated}}">
    <view class="empty">
      <view class="empty-illustration">🗒️</view>
      <view class="empty-title">暂无笔记</view>
      <view class="empty-sub">你的备忘将出现在这里，点击下方按钮添加第一条</view>
      <button class="add-btn" bindtap="focusInput">添加笔记</button>
    </view>
  </block>

  <view wx:else class="grid" wx:if="{{isAuthenticated}}">
    <block wx:for="{{notes}}" wx:key="id">
      <view class="card" data-id="{{item.id}}" bindtap="openDetail" bindlongpress="onLongPressDelete">
        <view class="card-title">{{item.title || ('笔记 #' + item.id)}}</view>
        <view class="card-content">{{item.content}}</view>
        <view class="card-footer">
          <view class="date">{{item.displayDate}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="footer" wx:if="{{isAuthenticated}}">
    <input class="input" placeholder="输入备忘内容" bindinput="onInput" value="{{draft}}" />
    <button class="save-btn" bindtap="createNote">保存</button>
  </view>

  <view class="auth-actions" wx:if="{{!isAuthenticated}}">
    <button bindtap="goLogin">登录</button>
    <button bindtap="goRegister">注册</button>
  </view>
</view>
