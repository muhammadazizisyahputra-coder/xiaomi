# Example environment variables for server

# MySQL connection (replace with your credentials)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_notes
DB_USER=root
DB_PASS=changeme

# Server
PORT=8080

# JWT
JWT_SECRET=replace_this_with_strong_secret
JWT_EXPIRES_IN=7d

# MIMO (AI service) - replace with actual endpoint/key
MIMO_API_URL=https://api.mimo.example/v1/parse
MIMO_API_KEY=your-mimo-api-key

# Worker polling interval in milliseconds
TASK_POLL_INTERVAL=3000
